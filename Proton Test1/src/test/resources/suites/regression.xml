<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <listeners>
    <listener class-name="com.punitpv48.automation.listeners.ExtentReportListener"/>
  </listeners>
  <test name="Regression Tests">
    <classes>
      <class name="com.punitpv48.automation.tests.smoke.SmokeTests"/>
      <class name="com.punitpv48.automation.tests.smoke.ApiSmokeTests"/>
      <class name="com.punitpv48.automation.tests.regression.LoginRegressionTests"/>
      <class name="com.punitpv48.automation.tests.regression.InventoryRegressionTests"/>
      <class name="com.punitpv48.automation.tests.api.ApiRegressionTests"/>
      <class name="com.punitpv48.automation.tests.api.ApiUiComparisonTests"/>
    </classes>
  </test>
</suite>
