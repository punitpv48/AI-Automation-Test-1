<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Proton Mail Regression Suite" thread-count="1" data-provider-thread-count="1">
  <listeners>
    <listener class-name="com.punitpv48.automation.listeners.ExtentReportListener"/>
  </listeners>
  <test name="Proton Mail Regression Tests">
    <classes>
      <class name="com.punitpv48.automation.tests.proton.ProtonSmokeTests"/>
      <class name="com.punitpv48.automation.tests.proton.ProtonRegressionTests"/>
    </classes>
  </test>
</suite>
